  "stats": {
    "nat_charge": "攻击时有 {chance} 概率改为蓄力：下次攻击必定命中、暴击率 +{crit}，伤害提升至 {value}。",
    "nat_execution": "当敌方生命低于 {threshold} 时，攻击有 {chance} 概率使伤害提升至 {value}。",
    "nat_lifesteal": "攻击时有 {chance} 概率进入嗜血：{turns} 次行动内，所造成伤害的 {value} 转化为自身生命。",
    "nat_poison": "攻击时有 {chance} 概率使敌方中毒：其每刻损失 {damage} 点生命，持续 {ticks} 刻。",
    "nat_concussive": "攻击时有 {chance} 概率改为重击：无视敌方 {value} 的防御，命中则令其 {ticks} 刻内无法行动。",
    "nat_thunder": "攻击时有 {chance} 概率改为雷罚：劈下至多 {max} 道真伤落雷，每道为攻击的 {value}，之后每道概率为前道的 {decay}。",
    "nat_sever": "敌方即将行动时有 {chance} 概率打断其行动并立即反击，造成 {value} 的伤害，其行动槽倒退 {delay}。",
    "nat_gauge_surge": "命中后有 {chance} 概率行动槽额外前进 {value}，若为暴击则改为前进 {crit_value}。",
    "nat_damage_reduction": "每次受到攻击时有 {chance} 概率叠加一层锻痕：伤害减免 +{value}，持续 {ticks} 刻。",
    "nat_reflect": "每次受到伤害时有 {chance} 概率触发反噬：免除该次伤害的 {value}，并将其以 {ratio} 反弹给攻击者。",
    "nat_bulwark": "自身生命不低于 {threshold} 时，所受伤害降低 {value}，且有 {immune} 的概率完全免疫伤害。",
    "nat_retribution": "受到攻击时有 {chance} 概率记录该次伤害（至多 {cap} 条）：下次命中将记录总和以 {ratio} 追加打出。",
    "nat_iron_will": "受到致命伤害时有 {chance} 概率重生并回复 {value} 最大生命；每次触发后概率衰减为前次的 {decay}。",
    "nat_heal": "行动开始时有 {chance} 概率回复 {value} 点生命，并施加回春印记：每 {tick} 刻回复 {regen} 点生命，持续 {duration} 刻。",
    "nat_cleanse": "行动开始时有 {chance} 概率驱散双方所有标记与增益减益（每驱散 1 种为自己回复 {per} 点生命），并回复 {value} 点生命。",
    "nat_low_hp_atk_bonus": "生命首次低于 {threshold} 时，攻击 +{value} 且速度 +{spd}，持续到战斗结束。",
    "nat_streak_bonus": "命中时有 {chance} 概率获得 1 层乘胜：每层伤害 +{value}，至多 {cap} 层；攻击落空时清零。",
    "nat_overload": "攻击时有 {chance} 概率消耗自身 {cost} 最大生命，使本次伤害提升至 {value}。",
    "nat_armor_shred": "攻击时有 {chance} 概率使对方防御 −{value}，持续 {ticks} 刻，至多叠加 {max_stacks} 层。",
    "nat_bleed": "攻击时有 {chance} 概率撕裂敌方：其每次行动损失相当于攻击者攻击 {value} 的生命，持续 {ticks} 刻。",
    "nat_gamble": "攻击时有 {chance} 概率伤害提升至 {value}，否则伤害降低至 {penalty}。",
    "nat_tempo": "每次行动完毕有 {chance} 概率速度 +{value}、攻击 +{atk}。",
    "nat_armor_pen": "攻击时有 {chance} 概率洞悉弱点：本次攻击无视全部防御，且暴击率 +{crit}。",
    "nat_blood_pact": "每次行动开始有 {chance} 概率消耗 {cost} 最大生命，本次攻击附带 {value} 吸血；然后按吸血量的 {convert} 永久增加攻击。",
    "nat_grudge": "被命中时有 {chance} 概率积攒 1 层怨念（持续 {ticks} 刻）：每层使伤害 +{value}。",
    "link_formula": "（{base} + {expr}*{merged}）",
